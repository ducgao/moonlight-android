<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="244dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="10dp">
    <FrameLayout
        android:id="@+id/carousel_card"
        android:layout_width="224dp"
        android:layout_height="224dp"
        android:background="@drawable/carousel_card_bg">
        <!-- Strongly blurred copy of the art filling the whole square -->
        <ImageView
            android:id="@+id/carousel_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
        <!-- Slight darkening so the poster stands out -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000" />
        <!-- Whole artwork as a rounded poster with a shadow, never cropped -->
        <com.limelight.ui.CoverArtView
            android:id="@+id/grid_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:maxWidth="188dp"
            android:maxHeight="188dp"
            android:scaleType="fitCenter"
            android:background="@drawable/cover_poster_bg"
            android:elevation="10dp" />
        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />
        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/carousel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="18sp" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/carousel_btn_primary"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="12dp"
            android:background="@drawable/carousel_action_bg"
            android:clickable="true"
            android:focusable="false">
            <TextView style="@style/HintChip" android:text="A" />
            <TextView
                android:id="@+id/carousel_btn_primary_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:textColor="#FFE5E5EA"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/carousel_btn_close"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginLeft="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="12dp"
            android:background="@drawable/carousel_action_bg"
            android:clickable="true"
            android:focusable="false">
            <TextView style="@style/HintChip" android:text="X" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="@string/carousel_close"
                android:textColor="#FFE5E5EA"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
