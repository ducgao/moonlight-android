<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="264dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="12dp">
    <FrameLayout
        android:id="@+id/carousel_card"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/carousel_frame_bg"
        android:foreground="@drawable/carousel_frame_fg">
        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/pc_case" />
        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center" />
        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="22sp" />
    <TextView
        android:id="@+id/carousel_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="#FF9A9AA5"
        android:textSize="14sp" />
</LinearLayout>
